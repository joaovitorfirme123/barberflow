# Ambiente da aplicação
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=troque-por-um-segredo-local-com-no-minimo-32-caracteres
BOOKING_SLOT_INTERVAL_MINUTES=30
BOOKING_MIN_NOTICE_MINUTES=60
BOOKING_MAX_FUTURE_DAYS=60

# PostgreSQL local
POSTGRES_DB=barberflow
POSTGRES_USER=barberflow
POSTGRES_PASSWORD=barberflow_dev_password
POSTGRES_PORT=5432

# Usada pelo Next.js/Prisma fora do Docker
DATABASE_URL=postgresql://barberflow:barberflow_dev_password@localhost:5432/barberflow?schema=public
