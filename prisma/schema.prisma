generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  PROFESSIONAL
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Barbershop {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  slug          String         @unique
  phone         String?
  address       String?
  instagram     String?
  logoUrl       String?
  timezone      String         @default("America/Sao_Paulo")
  minBookingNoticeMinutes Int   @default(60)
  maxBookingDays Int            @default(60)
  slotIntervalMinutes Int       @default(30)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  professionals Professional[]
  services      Service[]
  businessHours BusinessHour[]
  scheduleBlocks ScheduleBlock[]
  customers     Customer[]
  appointments  Appointment[]

  @@index([createdAt])
  @@map("barbershops")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  barbershopId String     @db.Uuid
  name         String
  email        String
  passwordHash String
  role         UserRole   @default(OWNER)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, email])
  @@index([email])
  @@map("users")
}

model Professional {
  id                  String                @id @default(uuid()) @db.Uuid
  barbershopId        String                @db.Uuid
  name                String
  photoUrl            String?
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  barbershop          Barbershop            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  services            ProfessionalService[]
  appointments        Appointment[]
  scheduleBlocks      ScheduleBlock[]

  @@index([barbershopId, active])
  @@map("professionals")
}

model Service {
  id                  String                @id @default(uuid()) @db.Uuid
  barbershopId        String                @db.Uuid
  name                String
  description         String?
  price               Decimal               @db.Decimal(10, 2)
  durationMinutes     Int
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  barbershop          Barbershop            @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  professionals       ProfessionalService[]
  appointments        Appointment[]

  @@index([barbershopId, active])
  @@map("services")
}

model ProfessionalService {
  professionalId String       @db.Uuid
  serviceId      String       @db.Uuid
  customPrice    Decimal?     @db.Decimal(10, 2)
  customDuration Int?
  professional   Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@map("professional_services")
}

model BusinessHour {
  id           String     @id @default(uuid()) @db.Uuid
  barbershopId String     @db.Uuid
  weekday      Int
  openTime     String
  closeTime    String
  breakStart   String?
  breakEnd     String?
  closed       Boolean    @default(false)
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, weekday])
  @@map("business_hours")
}

model ScheduleBlock {
  id           String     @id @default(uuid()) @db.Uuid
  barbershopId String     @db.Uuid
  professionalId String?  @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  createdAt    DateTime   @default(now())
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([barbershopId, startsAt, endsAt])
  @@index([professionalId, startsAt, endsAt])
  @@map("schedule_blocks")
}

model Customer {
  id           String        @id @default(uuid()) @db.Uuid
  barbershopId String        @db.Uuid
  name         String
  phone        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  barbershop   Barbershop    @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([barbershopId, phone])
  @@index([barbershopId, name])
  @@map("customers")
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  barbershopId   String            @db.Uuid
  professionalId String            @db.Uuid
  serviceId      String            @db.Uuid
  customerId     String            @db.Uuid
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  barbershop     Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  professional   Professional      @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service        Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([barbershopId, startsAt])
  @@index([professionalId, startsAt, endsAt])
  @@index([customerId, startsAt])
  @@map("appointments")
}
